# Copy this file to .env and fill in the values. .env is gitignored and never uploaded.

# The brain. LiteLLM prefix picks the provider; the matching *_API_KEY must be set.
AGENT_MODEL=xai/grok-4.6
XAI_API_KEY=

# Hearing (audio transcription only). Free key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# MEDIA_MODELS=gemini/gemini-3.8-flash,gemini/gemini-3.6-flash,gemini/gemini-3.5-flash

# Only needed for the final --submit step.
HF_USERNAME=
SPACE_ID=
